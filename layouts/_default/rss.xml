{{- $pages := slice -}}
{{- if .IsHome -}}
    {{- $pages = where site.RegularPages "Section" "in" (slice "posts" "links" "logs" "essays") -}}
    {{- $pages = union $pages (where site.RegularPages "Type" "now") -}}
{{- else if eq .Section "essays" -}}
    {{- $pages = where site.RegularPages "Section" "in" (slice "posts" "essays") -}}
{{- else -}}
    {{- $pages = .RegularPages -}}
{{- end -}}
{{- $pages = where $pages "Params.excludeFromRss" "!=" true -}}
{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\"?>\n" | safeHTML -}}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
<channel>
    <title>{{ if .IsHome }}{{ site.Title }}{{ else }}{{ .Title }} on {{ site.Title }}{{ end }}</title>
    <link>{{ .Permalink }}</link>
    <description>{{ site.Params.description }}</description>
    <language>{{ site.Language.Lang }}</language>
    {{ with .OutputFormats.Get "RSS" }}<atom:link href="{{ .Permalink }}" rel="self" type="application/rss+xml" />{{ end }}
    {{ range $pages.ByDate.Reverse }}
    <item>
        <title>{{ .Title }}</title>
        <link>{{ .Permalink }}</link>
        <guid>{{ .Permalink }}</guid>
        <pubDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" }}</pubDate>
        {{ $body := .Content | replaceRE `(?i)(src|href)="/([^"#]+)` (printf `${1}="%s${2}` site.BaseURL) }}
        <description>{{ $body }}</description>
    </item>
    {{ end }}
</channel>
</rss>
